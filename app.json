{
  "expo": {
    "name": "Itinova",
    "slug": "Itinova",
    "scheme": "itinova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffaf0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-maps",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bongsub.Itinova"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffaf0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
